# Local development fallback. Existing .env credentials are never overwritten.
DATABASE_URL=file:./local.db
DATABASE_AUTH_TOKEN=

# Turso database connection (database token, not an account-management token).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# auto uses Turso when TURSO_DATABASE_URL is present; local/turso select explicitly.
DB_TARGET=auto

# Set only while running sample seeds/tests. Never commit a real password.
SEED_PASSWORD=
