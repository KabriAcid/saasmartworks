# Supabase PostgreSQL connection string. Use the pooled URL for application requests.
POSTGRES_URL=
# Use the direct/non-pooling URL for schema migrations when available.
POSTGRES_URL_NON_POOLING=

# Generate a random value with at least 32 bytes; keep it server-only.
SESSION_SECRET=

# Set only while running sample seeds/tests. Never commit a real password.
SEED_PASSWORD=
